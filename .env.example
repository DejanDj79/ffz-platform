# Lemon Squeezy billing
# Test-mode IDs below belong to the FFZ Pro test product. Replace them with
# Live Mode IDs before enabling real charges.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=466440
LEMONSQUEEZY_PRODUCT_ID=1336641
LEMONSQUEEZY_MONTHLY_VARIANT_ID=2088449
LEMONSQUEEZY_ANNUAL_VARIANT_ID=2088459
# Create a separate one-time $199 Founder Trader variant and put its ID here.
LEMONSQUEEZY_FOUNDER_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true

# Password recovery (SMTP credentials stay on the server, never in Git).
# Use the exact public origin, without a path. HTTPS required in production.
FFZ_APP_URL=https://your-ffz-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Port 587 (or 2525) requires STARTTLS; port 465 uses implicit TLS.
