# FastSpring checkout
# Store Builder storefront and product paths are public identifiers, not secrets.
# Keep API credentials and webhook secrets server-side when they are added later.
NEXT_PUBLIC_FASTSPRING_STOREFRONT=
FASTSPRING_PRO_MONTHLY_PATH=pro-monthly
FASTSPRING_PRO_YEARLY_PATH=pro-yearly
FASTSPRING_FOUNDER_PATH=founder-trader

# Paddle billing
# Legacy integration is kept temporarily while FastSpring is being validated.
# Client-side tokens (test_/live_) are safe for Paddle.js; API keys and webhook
# secrets must remain server-side and must never be committed.
PADDLE_CLIENT_TOKEN=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_ANNUAL_PRICE_ID=
PADDLE_FOUNDER_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox

# Temporary public review mode for payment-provider/domain verification.
# When true, logged-out requests to protected app pages are redirected to the
# public pricing page instead of being sent to login.
FFZ_PUBLIC_REVIEW_MODE=false

# Password recovery (SMTP credentials stay on the server, never in Git).
# Use the exact public origin, without a path. HTTPS required in production.
FFZ_APP_URL=https://your-ffz-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Port 587 (or 2525) requires STARTTLS; port 465 uses implicit TLS.
